# ======================================================================
# AgentMesh Platform — Production Environment Variables
# ======================================================================
# Copy this file to .env and fill in the values:
#   cp .env.prod.example .env
# Then edit .env with your production values.
# ======================================================================

# ----- Database ------------------------------------------------------
# Directory where the SQLite database file will be stored.
# Must be writable by the container user. Used for persistent data.
# Default: /var/lib/agentmesh/data
# Required: no
AGENTMESH_DB_DIR=/var/lib/agentmesh/data

# ----- Logging -------------------------------------------------------
# Log level: debug, info, warning, error, critical.
# Use "info" for production, "debug" for troubleshooting.
# Default: info
# Required: no
AGENTMESH_LOG_LEVEL=info

# --- File log directory (only used when file logging is active) ----
# Directory where structured JSON log files are written.
# Default: /var/lib/agentmesh/logs
# Required: no
AGENTMESH_LOG_DIR=/var/lib/agentmesh/logs

# ----- Server --------------------------------------------------------
# Host address to bind the HTTP server.
# Use "0.0.0.0" to listen on all interfaces (needed in Docker).
# Default: 0.0.0.0
# Required: no
AGENTMESH_HOST=0.0.0.0

# Port number for the HTTP server.
# Default: 8000
# Required: no
AGENTMESH_PORT=8000

# Number of uvicorn worker processes.
# Set to 2-4 per CPU core for production. Use "1" for debugging.
# Default: 4
# Required: no
AGENTMESH_WORKERS=4

# ----- Security ------------------------------------------------------
# Secret key used for session signing, token encryption, etc.
# Generate a strong random key:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Default: (no default - must be set in production)
# Required: yes
AGENTMESH_SECRET_KEY=

# ----- (Optional) External services ----------------------------------
# Example: external PostgreSQL connection string (for future use)
# When unset, SQLite is used.
# Required: no
# DATABASE_URL=postgresql://user:password@host:5432/agentmesh

# ----- (Optional) Sentry / Error tracking ----------------------------
# DSN for Sentry error monitoring. Leave empty to disable.
# Default: (empty)
# Required: no
# SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@xxxxx.ingest.sentry.io/xxxxxx
